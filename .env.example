# Copy to .env.local and fill in the values.
#
# This is a fully static site with no server. Every variable is prefixed
# NEXT_PUBLIC_ and gets inlined into the client bundle at build time —
# never put secrets here.
#
# Production values are configured in the Vercel dashboard under
# Settings -> Environment Variables.

# Blog link target for the "Blogs" button on the home page.
# The code falls back to a default when this is unset.
NEXT_PUBLIC_BLOG_URL=https://liuyang19900520.github.io/
