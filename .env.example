# Environment Configuration
# Copy this file to .env.local and fill in the values

# ============================================
# Environment
# ============================================
# 'local' or 'prod'
NEXT_PUBLIC_ENV=local

# ============================================
# AWS DynamoDB (Direct SDK Access)
# ============================================
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=ap-northeast-1

# ============================================
# API URLs
# ============================================
# Investment API Base URL
# Local: not needed (direct DynamoDB access)
# Prod: Your AWS API Gateway URL (legacy)
INVESTMENT_API_BASE_URL=

# API Gateway URL (optional fallback)
API_GATEWAY_URL=

# Stock API Base URL
# Local: http://127.0.0.1:8000
# Prod: Your stock API service URL
STOCK_API_BASE_URL=

# ============================================
# External URLs
# ============================================
# Cases App URL (for iframe embedding)
NEXT_PUBLIC_CASES_APP_URL=

# Blog URL (external link)
NEXT_PUBLIC_BLOG_URL=

# ============================================
# Google Cloud Vision OCR
# ============================================
# Google API Key for Cloud Vision service
GOOGLE_API_KEY=

